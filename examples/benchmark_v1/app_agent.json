        "params": {
          "phone_folder_path": "/storage/emulated/0/Pictures"
        }
      },
      {
        "name": "android_injection_push_file",
        "params": {
          "files": [
            {
              "local_path": "data/AppAgent/data/appagent_7.png",
              "device_path": "/storage/emulated/0/Pictures/fineday.jpg",
              "media_scan": true
            }
