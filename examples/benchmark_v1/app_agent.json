      "params": {
        "method": "multi_image_qa",
        "images": "last:6",
        "max_images": 8,
        "prompt": "The screenshots are from an X (Twitter) task in chronological order (earlier to later). The expected tweet text is exactly: '${text}'. Verify ALL three requirements using the full sequence: (1) COMPOSE SCREEN REACHED — at least one screenshot shows the new-post/compose UI where text and a photo can be attached (not only the home timeline). (2) CORRECT CONTENT — the compose screen shows that exact text '${text}' AND an image/photo is attached or visible in the composer preview. (3) SUCCESSFULLY PUBLISHED — not only an unsent draft, not a failed/error state. Reply PASS only if all three are clearly satisfied; otherwise FAIL and state which step (1), (2), or (3) failed."
      }
    }
  },
  {
    "id": "appagent_8",
    "instruction": "search for the user Lebron James and follow him",
    "app": "x",
    "requires_login": true,
    "type": "static",
    "task_initializer": {},
    "environment_initializer": [
      {
        "name": "android_network_check_network",
        "params": {}
      },
      {
        "name": "ui_judge_ui",
        "params": {
          "wait_after": 2,
          "steps": [
            {
              "action": "start_app",
              "params": {
                "app_name": "x"
              },
              "wait_after": 4
            },
            {
              "action": "tap",
              "params": {
                "x": 248,
                "y": 2190
              },
              "wait_after": 2
            },
            {
              "action": "tap",
              "params": {
                "x": 189,
                "y": 154
              },
              "wait_after": 1.5
            },
            {
              "action": "type",
              "params": {
                "text": "Lebron James"
              },
              "wait_after": 1.5
            },
            {
              "action": "tap",
              "params": {
                "x": 963,
                "y": 2149
              },
              "wait_after": 3
            },
            {
              "action": "judge",
              "on_match": "break",
              "wait_before": 5,
              "wait_after": 0,
              "params": [
                {
                  "fields": [
                    "text"
                  ],
                  "content": [
                    "follow"
                  ]
                }
              ]
            },
            {
              "action": "judge",
              "on_match": "continue",
              "wait_after": 0,
              "params_logic": "any",
              "params": [
                {
                  "fields": [
                    "text"
                  ],
                  "content": [
                    "following"
                  ]
                },
                {
                  "fields": [
                    "content_desc"
                  ],
                  "content": [
                    "following"
                  ],
                  "match_modes": [
                    "contains"
                  ]
                }
              ]
            },
            {
              "action": "tap",
              "run_if_judge": "matched",
              "params": {
                "x": 1050,
                "y": 520
              },
              "wait_after": 2
            },
            {
              "action": "home",
              "run_if_judge": "always",
              "params": {},
              "wait_after": 1
            }
          ]
        }
      },
      {
        "name": "android_app_warm_reset",
        "params": {
          "app": "x"
        }
      }
    ],
    "evaluator": {
      "name": "system_state",
      "params": {
        "method": "ui_text_validator",
        "metric": "contains_any",
        "expected_text": [
          "Following",
          "Lebron James"
        ]
      }
    }
  },
