    "id": "appagent_1",
    "instruction": "search for Walmart Supercenter, get directions for driving and start navigation",
    "app": "maps",
    "type": "static",
    "task_initializer": {},
    "environment_initializer": [
      {
        "name": "android_network_check_network",
        "params": {}
      },
      {
        "name": "android_reset_reset_app_data",
        "params": {
          "app": "maps"
        }
      },
      {
        "name": "android_app_warm_reset",
        "params": {
          "app": "maps"
        }
      }
    ],
    "evaluator": {
      "name": "vision_mllm",
      "params": {
        "method": "multi_image_qa",
        "images": "last:6",
        "max_images": 8,
        "prompt": "The screenshots are from a Google Maps task in chronological order (earlier to later). Verify BOTH requirements: (1) The destination is Walmart Supercenter— the name must appear clearly in search results, place details, or the navigation header. (2) Driving navigation has been started — show active navigation UI (e.g. route in progress, turn-by-turn, Exit navigation), not only a directions preview or route overview without navigation started. Reply PASS only if both are clearly satisfied; otherwise FAIL with the missing requirement."
      }
    }
  },
